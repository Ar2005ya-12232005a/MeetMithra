# ============================================================
# MeetMithra — Backend Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit .env to Git.
# ============================================================

# ── LLM Providers ────────────────────────────────────────────
# Use Anthropic Claude (primary) or OpenAI as fallback
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# ── Supabase (Database + Auth) ────────────────────────────────
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# Full Postgres connection string (from Supabase > Settings > Database)
DATABASE_URL=

# ── CORS / Networking ─────────────────────────────────────────
# URL of the frontend, used for CORS allow-list
FRONTEND_URL=http://localhost:3000

# ── LangSmith (optional — LangChain tracing) ──────────────────
LANGSMITH_API_KEY=
LANGSMITH_TRACING=false
LANGSMITH_PROJECT=meetmithra

# ── Slack Integration (optional) ──────────────────────────────
SLACK_WEBHOOK_URL=
