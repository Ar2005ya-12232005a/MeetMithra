# ============================================================
# MeetMithra — Root Environment Reference
#
# This is a REFERENCE ONLY. Do not use this file directly.
#
#   Backend vars  → copy to  backend/.env
#   Frontend vars → copy to  frontend/.env.local
#
# Neither file should ever be committed to Git.
# ============================================================

# ── BACKEND (backend/.env) ────────────────────────────────────
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

SUPABASE_URL=
SUPABASE_SERVICE_KEY=
DATABASE_URL=

FRONTEND_URL=http://localhost:3000

LANGSMITH_API_KEY=
LANGSMITH_TRACING=false
LANGSMITH_PROJECT=meetmithra

SLACK_WEBHOOK_URL=

# ── FRONTEND (frontend/.env.local) ───────────────────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000